<test-suite suite-name="productmanagementtests"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/test-suite.xsd">

    <!-- Test Case 1: Test findProduct service                     -->
    <!-- Search for products by name (partial, case-insensitive)   -->
    <test-case case-name="findProduct_ByName">
        <service-test service-name="findProduct">
            <field-test field-name="productList"/>
        </service-test>
    </test-case>

    <!-- Test Case 2: Test createProduct service                   -->
    <!-- Create a new product with unique name                     -->
    <test-case case-name="createProduct_NewProduct">
        <service-test service-name="createProduct">
            <field-test field-name="productId"/>
        </service-test>
    </test-case>

</test-suite>
