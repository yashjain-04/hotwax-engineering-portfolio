<entitymodel xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/entitymodel.xsd">
    <!-- ========================================================= -->
    <!-- ======================== Defaults ======================= -->
    <!-- ========================================================= -->
    <title>Entity of Ordermgmtsystem Component</title>
    <description>None</description>
    <copyright></copyright>
    <version></version>
    <entity entity-name="OmsOrderType" package-name="com.hotwax.oms.order" title="Order Type">
        <field name="orderTypeId" type="id"></field>
        <field name="description" type="description"></field>
        <prim-key field="orderTypeId"/>
    </entity>

    <entity entity-name="OmsOrderHeader" package-name="com.hotwax.oms.order" title="Order Header">
        <field name="orderId" type="id"></field>
        <field name="orderTypeId" type="id"></field>
        <field name="orderName" type="name"></field>
        <field name="externalId" type="id"></field>
        <field name="orderDate" type="date-time"></field>
        <field name="statusId" type="id"></field>
        <prim-key field="orderId"/>
        <relation type="one" fk-name="OMS_ORD_TYPE" rel-entity-name="OmsOrderType">
            <key-map field-name="orderTypeId"/>
        </relation>
    </entity>

    <entity entity-name="OmsOrderItemType" package-name="com.hotwax.oms.order" title="Order Item Type">
        <field name="orderItemTypeId" type="id"></field>
        <field name="description" type="description"></field>
        <prim-key field="orderItemTypeId"/>
    </entity>

    <entity entity-name="OmsOrderItem" package-name="com.hotwax.oms.order" title="Order Item">
        <field name="orderId" type="id"></field>
        <field name="orderItemSeqId" type="id"></field>
        <field name="orderItemTypeId" type="id"></field>
        <field name="productId" type="id"></field>
        <field name="quantity" type="fixed-point"></field>
        <field name="unitPrice" type="currency-amount"></field>
        <field name="itemDescription" type="description"></field>
        <field name="statusId" type="id"></field>
        <field name="estimatedShipDate" type="date-time"></field>
        <field name="estimatedDeliveryDate" type="date-time"></field>
        <prim-key field="orderId"/>
        <prim-key field="orderItemSeqId"/>
        <relation type="one" fk-name="OMS_OITM_HDR" rel-entity-name="OmsOrderHeader">
            <key-map field-name="orderId"/>
        </relation>
        <relation type="one" fk-name="OMS_OITM_TYPE" rel-entity-name="OmsOrderItemType">
            <key-map field-name="orderItemTypeId"/>
        </relation>
    </entity>

    <entity entity-name="OmsOrderRole" package-name="com.hotwax.oms.order" title="Order Role">
        <field name="orderId" type="id"></field>
        <field name="partyId" type="id"></field>
        <field name="roleTypeId" type="id"></field>
        <prim-key field="orderId"/>
        <prim-key field="partyId"/>
        <prim-key field="roleTypeId"/>
        <relation type="one" fk-name="OMS_ORL_HDR" rel-entity-name="OmsOrderHeader">
            <key-map field-name="orderId"/>
        </relation>
    </entity>

