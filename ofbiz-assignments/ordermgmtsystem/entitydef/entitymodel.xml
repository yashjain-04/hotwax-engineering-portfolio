        <field name="orderId" type="id"></field>
        <field name="orderItemSeqId" type="id"></field>
        <field name="orderPaymentPreferenceId" type="id"></field>
        <field name="statusDatetime" type="date-time"></field>
        <field name="statusUserLogin" type="id-long"></field>
        <field name="changeReason" type="description"></field>
        <prim-key field="orderStatusId"/>
        <relation type="one" fk-name="OMS_OSTS_HDR" rel-entity-name="OmsOrderHeader">
            <key-map field-name="orderId"/>
        </relation>
    </entity>

    <entity entity-name="OmsOrderTermType" package-name="com.hotwax.oms.order" title="Order Term Type">
        <field name="orderTermTypeId" type="id"></field>
        <field name="description" type="description"></field>
        <prim-key field="orderTermTypeId"/>
    </entity>

    <entity entity-name="OmsOrderTerm" package-name="com.hotwax.oms.order" title="Order Term">
        <field name="orderTermId" type="id"></field>
        <field name="orderTermTypeId" type="id"></field>
        <field name="orderId" type="id"></field>
        <field name="orderItemSeqId" type="id"></field>
        <field name="termValue" type="currency-amount"></field>
        <field name="termDays" type="numeric"></field>
        <field name="textValue" type="description"></field>
        <field name="description" type="description"></field>
        <prim-key field="orderTermId"/>
        <relation type="one" fk-name="OMS_OTRM_HDR" rel-entity-name="OmsOrderHeader">
            <key-map field-name="orderId"/>
        </relation>
        <relation type="one" fk-name="OMS_OTRM_TYPE" rel-entity-name="OmsOrderTermType">
            <key-map field-name="orderTermTypeId"/>
        </relation>
    </entity>

    <entity entity-name="OmsOrderItemAssocType" package-name="com.hotwax.oms.order" title="Order Item Association Type">
        <field name="orderItemAssocTypeId" type="id"></field>
        <field name="description" type="description"></field>
        <prim-key field="orderItemAssocTypeId"/>
    </entity>

    <entity entity-name="OmsOrderItemAssoc" package-name="com.hotwax.oms.order" title="Order Item Association">
        <field name="orderId" type="id"></field>
        <field name="orderItemSeqId" type="id"></field>
        <field name="shipGroupSeqId" type="id"></field>
        <field name="toOrderId" type="id"></field>
        <field name="toOrderItemSeqId" type="id"></field>
        <field name="toShipGroupSeqId" type="id"></field>
        <field name="orderItemAssocTypeId" type="id"></field>
        <field name="quantity" type="fixed-point"></field>
        <prim-key field="orderId"/>
        <prim-key field="orderItemSeqId"/>
        <prim-key field="shipGroupSeqId"/>
        <prim-key field="toOrderId"/>
        <prim-key field="toOrderItemSeqId"/>
        <prim-key field="toShipGroupSeqId"/>
        <prim-key field="orderItemAssocTypeId"/>
        <relation type="one" fk-name="OMS_OIA_HDR" title="Main" rel-entity-name="OmsOrderHeader">
            <key-map field-name="orderId"/>
        </relation>
        <relation type="one" fk-name="OMS_OIA_TO_HDR" title="To" rel-entity-name="OmsOrderHeader">
            <key-map field-name="toOrderId" rel-field-name="orderId"/>
        </relation>
        <relation type="one" fk-name="OMS_OIA_TYPE" rel-entity-name="OmsOrderItemAssocType">
            <key-map field-name="orderItemAssocTypeId"/>
        </relation>
    </entity>

    <entity entity-name="OmsOrderPaymentPreference" package-name="com.hotwax.oms.order" title="Order Payment Preference">
        <field name="orderPaymentPreferenceId" type="id"></field>
        <field name="orderId" type="id"></field>
        <field name="orderItemSeqId" type="id"></field>
        <field name="shipGroupSeqId" type="id"></field>
        <field name="paymentMethodTypeId" type="id"></field>
        <field name="paymentMethodId" type="id"></field>
        <field name="finAccountId" type="id"></field>
        <field name="maxAmount" type="currency-amount"></field>
        <field name="statusId" type="id"></field>
        <prim-key field="orderPaymentPreferenceId"/>
        <relation type="one" fk-name="OMS_OPP_HDR" rel-entity-name="OmsOrderHeader">
            <key-map field-name="orderId"/>
        </relation>
    </entity>

</entitymodel>