        <relation type="one" fk-name="OMS_OCM_HDR" rel-entity-name="OmsOrderHeader">
            <key-map field-name="orderId"/>
        </relation>
    </entity>

    <entity entity-name="OmsOrderAdjustmentType" package-name="com.hotwax.oms.order" title="Order Adjustment Type">
        <field name="orderAdjustmentTypeId" type="id"></field>
        <field name="description" type="description"></field>
        <prim-key field="orderAdjustmentTypeId"/>
    </entity>

    <entity entity-name="OmsOrderAdjustment" package-name="com.hotwax.oms.order" title="Order Adjustment">
        <field name="orderAdjustmentId" type="id"></field>
        <field name="orderAdjustmentTypeId" type="id"></field>
        <field name="orderId" type="id"></field>
        <field name="orderItemSeqId" type="id"></field>
        <field name="description" type="description"></field>
        <field name="amount" type="currency-amount"></field>
        <prim-key field="orderAdjustmentId"/>
        <relation type="one" fk-name="OMS_OADJ_HDR" rel-entity-name="OmsOrderHeader">
            <key-map field-name="orderId"/>
        </relation>
        <relation type="one" fk-name="OMS_OADJ_TYPE" rel-entity-name="OmsOrderAdjustmentType">
            <key-map field-name="orderAdjustmentTypeId"/>
        </relation>
    </entity>

    <entity entity-name="OmsOrderStatus" package-name="com.hotwax.oms.order" title="Order Status">
        <field name="orderStatusId" type="id"></field>
        <field name="statusTypeId" type="id"></field>
