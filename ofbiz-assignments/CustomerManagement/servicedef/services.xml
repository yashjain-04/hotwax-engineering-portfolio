<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/services.xsd">
    <description>CustomerManagement Services</description>
    <vendor></vendor>
    <version>1.0</version>

    <service name="findCustomer" engine="java" location="com.customer.management.CustomerServices" invoke="findCustomer" auth="true">
        <description>Find customers by search criteria</description>
        <attribute name="partyId" type="String" mode="IN" optional="true"/>
        <attribute name="emailAddress" type="String" mode="IN" optional="true"/>
        <attribute name="firstName" type="String" mode="IN" optional="true"/>
        <attribute name="lastName" type="String" mode="IN" optional="true"/>
        <attribute name="contactNumber" type="String" mode="IN" optional="true"/>
        <attribute name="address1" type="String" mode="IN" optional="true"/>
        <attribute name="city" type="String" mode="IN" optional="true"/>
        <attribute name="customers" type="java.util.List" mode="OUT" optional="true"/>
    </service>

    <service name="createCustomer" engine="java" location="com.customer.management.CustomerServices" invoke="createCustomer" auth="true">
        <description>Create a new customer</description>
        <attribute name="emailAddress" type="String" mode="IN" optional="false"/>
        <attribute name="firstName" type="String" mode="IN" optional="false"/>
        <attribute name="lastName" type="String" mode="IN" optional="false"/>
        <attribute name="contactNumber" type="String" mode="IN" optional="true"/>
        <attribute name="address1" type="String" mode="IN" optional="true"/>
        <attribute name="city" type="String" mode="IN" optional="true"/>
        <attribute name="postalCode" type="String" mode="IN" optional="true"/>
        <attribute name="partyId" type="String" mode="OUT" optional="true"/>
    </service>

    <service name="updateCustomer" engine="java" location="com.customer.management.CustomerServices" invoke="updateCustomer" auth="true">
        <description>Update customer details</description>
        <attribute name="emailAddress" type="String" mode="IN" optional="false"/>
        <attribute name="firstName" type="String" mode="IN" optional="true"/>
        <attribute name="lastName" type="String" mode="IN" optional="true"/>
        <attribute name="contactNumber" type="String" mode="IN" optional="true"/>
        <attribute name="address1" type="String" mode="IN" optional="true"/>
        <attribute name="city" type="String" mode="IN" optional="true"/>
        <attribute name="postalCode" type="String" mode="IN" optional="true"/>
    </service>

    <service name="createCustomerRelationship" engine="java" location="com.customer.management.CustomerServices" invoke="createCustomerRelationship" auth="true">
        <description>Create Customer Relationship</description>
        <attribute name="partyIdFrom" type="String" mode="IN" optional="false"/>
        <attribute name="partyIdTo" type="String" mode="IN" optional="false"/>
        <attribute name="partyRelationshipTypeId" type="String" mode="IN" optional="false"/>
    </service>

    <service name="updateCustomerRelationship" engine="java" location="com.customer.management.CustomerServices" invoke="updateCustomerRelationship" auth="true">
        <description>Update Customer Relationship</description>
        <attribute name="partyIdFrom" type="String" mode="IN" optional="false"/>
        <attribute name="partyIdTo" type="String" mode="IN" optional="false"/>
        <attribute name="partyRelationshipTypeId" type="String" mode="IN" optional="false"/>
        <attribute name="statusId" type="String" mode="IN" optional="false"/>
    </service>
</services>