			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Parse the JSON response",
							"let responseData = pm.response.json();",
							"",
							"// Make sure the shipmentIds array exists and grab the first one",
							"if (responseData.shipmentIds && responseData.shipmentIds.length > 0) {",
							"    pm.environment.set(\"shipmentId\", responseData.shipmentIds[0]); // Set the shipmentId in the environment variables",
							"    pm.execution.setNextRequest(\"Pack\");",
							"    console.log(\"Pick Executed\");",
							"}",
							"else{",
							"    pm.execution.setNextRequest(null);",
							"    console.log(\"Error while picking\");",
							"}"
						],
